# Local IP of your Hue bridge (see the Hue app, or https://discovery.meethue.com)
HUE_BRIDGE_IP=192.168.1.10

# API username created by pressing the bridge link button (see README)
HUE_TOKEN=your-hue-username

# Light IDs to animate, separated by commas (run `php main.php lights` to list them)
LIGHTS=1,2,3

# Each effect runs for a random duration between these bounds (seconds)
MIN_DURATION=30
MAX_DURATION=120

# Print every command sent to the bridge
DEBUG=false
